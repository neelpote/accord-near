{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "frontend/", "framework": "nextjs" },
    "api": { "root": "backend/", "runtime": "container", "entrypoint": "Dockerfile#hosted-api" }
  },
  "rewrites": [
    { "source": "/api/near/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "daemons": {
    "dispatch": {
      "root": "backend/",
      "entrypoint": "Dockerfile#hosted-worker",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "livenessProbe": { "httpGet": { "port": 4000, "path": "/ready" }, "initialDelaySeconds": 90, "periodSeconds": 30, "timeoutSeconds": 10, "failureThreshold": 3 }
    }
  }
}
